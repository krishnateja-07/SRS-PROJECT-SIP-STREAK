{
  "name": "sipstreak-hydrohero-hunt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run coverage && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vercel/blob": "^2.9.0",
    "chart.js": "^4.6.1",
    "framer-motion": "^14.14.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
